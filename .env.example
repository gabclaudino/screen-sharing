NODE_ENV=production            # production | development
HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGIN=https://share.seudominio.com
ACCESS_PASSWORD=troque-isto
SESSION_SECRET=string-aleatoria-longa
SESSION_TTL_HOURS=12
MAX_PEERS_PER_ROOM=6
LOGIN_RATE_MAX=10              # tentativas de login por janela
LOGIN_RATE_WINDOW_MIN=10
WS_MSG_RATE_PER_SEC=50
STATIC_DIR=packages/web/dist
ICE_PROVIDER=cloudflare        # cloudflare | metered | none
ICE_CREDENTIAL_TTL_SEC=86400     # deve ser maior que a sessão mais longa (Cloudflare aceita até 48 h)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
METERED_APP_NAME=
METERED_API_KEY=
# Apelidos forçados pelo servidor (JSON). Quem entrar com o nome da esquerda (sem diferenciar
# maiúsculas, acentos, espaços nem _ - .) aparece para todos com o nome da direita.
# Fica no .env (que não vai para o git), não no código. Exemplo:
#   NAME_ALIASES='{"fulano":"Apelido","fulano2":"Apelido"}'
NAME_ALIASES=

# Emojis dos botões de reação, separados por espaço ou vírgula (1 a 12, um emoji cada, na ordem
# dos botões). Vazio = 😂 🔥 💀 👏 ❤️ 😮. Exemplo:
#   REACTION_EMOJIS=🐸 🍕 🔥 😂
REACTION_EMOJIS=
