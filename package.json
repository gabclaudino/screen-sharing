{
  "name": "screenshare-mesh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "run-p dev:server dev:web",
    "dev:server": "npm run dev -w @screenshare/server",
    "dev:web": "npm run dev -w @screenshare/web",
    "build": "npm run typecheck && npm run build -w @screenshare/web",
    "start": "npm run start -w @screenshare/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
